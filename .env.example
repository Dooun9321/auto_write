# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Project
GCP_PROJECT_ID=your_gcp_project_id
BIGQUERY_DATASET=your_dataset_name

# Confluence
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_EMAIL=your_email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token
CONFLUENCE_SPACE_KEY=your_space_key

# Git Repository (for analyzing existing queries)
# For local repository: use local path (e.g., ./ or /path/to/repo)
# For remote repository: use git URL (e.g., https://github.com/user/repo.git)
GIT_REPO_PATH=./

# Git Authentication (optional, for private remote repositories)
# GitHub Personal Access Token
GIT_TOKEN=your_github_personal_access_token
# Or GitHub username/password (not recommended, use token instead)
GIT_USERNAME=
GIT_PASSWORD=

# Alternative: GitLab, Bitbucket tokens
# GITLAB_TOKEN=your_gitlab_token
# BITBUCKET_TOKEN=your_bitbucket_token
