# ============================================
# LLM Configuration
# ============================================
# Choose LLM provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Google Gemini API Key (alternative to OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ============================================
# BigQuery Configuration (Multi-Project Support)
# ============================================
# Multiple BigQuery projects (JSON format)
# Example: ["project1", "project2", "project3", "project4"]
BIGQUERY_PROJECTS=["your-project-1", "your-project-2", "your-project-3", "your-project-4"]

# Or use single project (legacy support)
# GCP_PROJECT_ID=your_gcp_project_id

# Default datasets per project (JSON format, optional)
# Example: {"project1": ["dataset1", "dataset2"], "project2": ["dataset3"]}
BIGQUERY_DATASETS={}

# ============================================
# Confluence Configuration
# ============================================
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_EMAIL=your_email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token
CONFLUENCE_SPACE_KEY=your_space_key

# Parent page ID to create documents under (optional)
# Leave empty to create at space root level
CONFLUENCE_PARENT_PAGE_ID=

# ============================================
# Git Repository Configuration (Multi-Repo Support)
# ============================================
# Multiple Git repositories (JSON format)
# Example: ["https://github.com/company/repo1.git", "https://github.com/company/repo2.git"]
GIT_REPOSITORIES=["./"]

# Or use single repository (legacy support)
# GIT_REPO_PATH=./

# Git Authentication (applies to all repositories)
# GitHub Personal Access Token (recommended)
GIT_TOKEN=your_github_personal_access_token

# Or username/password (not recommended, use token instead)
GIT_USERNAME=
GIT_PASSWORD=

# ============================================
# Advanced Settings
# ============================================
# Maximum number of repositories to analyze
MAX_REPOS_TO_ANALYZE=10

# Maximum files to analyze per repository
MAX_FILES_PER_REPO=50

# Enable automatic schema discovery
AUTO_DISCOVER_SCHEMAS=true
